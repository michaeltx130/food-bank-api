generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/mulege"
}

datasource db {
  provider = "mysql"
}

model beneficiarios {
  id      Int       @id @default(autoincrement())
  nombre  String?   @db.VarChar(100)
  familia familias?
}

model categorias {
  id     Int     @id @default(autoincrement()) @db.TinyInt
  nombre String? @db.VarChar(100)
}

model donantes {
  id       Int     @id @default(autoincrement())
  nombre   String? @db.VarChar(100)
  telefono String? @db.VarChar(20)
}

model familias {
  id                Int           @id @default(autoincrement())
  nombre            String?       @db.VarChar(100)
  telefono          String?       @db.VarChar(20)
  cantidad_miembros Int?
  direccion         String?       @db.VarChar(255)
  beneficiario_id   Int           @unique(map: "familias_beneficiario_id_unique")
  beneficiario      beneficiarios @relation(fields: [beneficiario_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "familias_beneficiario_id_fk")
}

model donaciones {
  id          Int       @id @default(autoincrement())
  donante     String?   @db.VarChar(100)
  producto_id Int?
  cantidad    Int?
  fecha       DateTime? @default(now()) @db.Timestamp(0)
}

model entregas {
  id              Int       @id @default(autoincrement())
  beneficiario_id Int?
  producto_id     Int?
  cantidad        Int?
  fecha           DateTime? @default(now()) @db.Timestamp(0)
}

model movimientos {
  id          Int               @id @default(autoincrement())
  producto_id Int?
  tipo        movimientos_tipo?
  cantidad    Int?
  fecha       DateTime?         @default(now()) @db.Timestamp(0)
}

model productos {
  id           Int     @id @default(autoincrement())
  nombre       String? @db.VarChar(100)
  categoria_id Int?    @db.TinyInt
  cantidad     Int?
  unit         String  @default("pz") @db.VarChar(20)
}

model transferencias {
  id               Int                       @id @default(autoincrement())
  transferencia_id String?                   @unique(map: "transferencia_id") @db.VarChar(80)
  producto_id      Int?
  producto_nombre  String?                   @db.VarChar(100)
  categoria_id     Int?
  cantidad         Int                       @default(0)
  origen           String?                   @db.VarChar(100)
  destino          String?                   @db.VarChar(100)
  estado           String                    @default("PENDIENTE") @db.VarChar(30)
  evento_id        String?                   @db.VarChar(80)
  error            String?                   @db.Text
  created_at       DateTime?                 @default(now()) @db.Timestamp(0)
  updated_at       DateTime?                 @default(now()) @updatedAt @db.Timestamp(0)
  aprobacion       transferencias_aprobacion @default(en_espera)
}

enum movimientos_tipo {
  entrada
  salida
  transferencia
}

enum transferencias_aprobacion {
  en_espera
  aceptado
  denegado
}
