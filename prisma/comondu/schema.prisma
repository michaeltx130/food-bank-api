generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/comondu"
}

datasource db {
  provider = "mysql"
}

model beneficiarios {
  id      Int       @id @default(autoincrement())
  nombre  String?   @db.VarChar(100)
  entregas entregas[]
  familia familias?
}

model categorias {
  id        Int         @id @default(autoincrement()) @db.TinyInt
  nombre    String      @db.VarChar(100)
  productos productos[]
}

model donantes {
  id       Int     @id @default(autoincrement())
  nombre   String? @db.VarChar(100)
  telefono String? @db.VarChar(20)
}

model familias {
  id                Int           @id @default(autoincrement())
  nombre            String?       @db.VarChar(100)
  telefono          String?       @db.VarChar(20)
  cantidad_miembros Int?
  direccion         String?       @db.VarChar(255)
  beneficiario_id   Int           @unique(map: "familias_beneficiario_id_unique")
  beneficiario      beneficiarios @relation(fields: [beneficiario_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "familias_beneficiario_id_fk")
}

model donaciones {
  id          Int       @id @default(autoincrement())
  donante     String?   @db.VarChar(100)
  producto_id Int?
  cantidad    Int?
  fecha       DateTime? @default(now()) @db.Timestamp(0)
  producto    productos? @relation(fields: [producto_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model entregas {
  id              Int       @id @default(autoincrement())
  beneficiario_id Int?
  producto_id     Int?
  cantidad        Int?
  fecha           DateTime? @default(now()) @db.Timestamp(0)
  beneficiario    beneficiarios? @relation(fields: [beneficiario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  producto        productos?     @relation(fields: [producto_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model movimientos {
  id          Int               @id @default(autoincrement())
  producto_id Int?
  tipo        movimientos_tipo?
  cantidad    Int?
  fecha       DateTime?         @default(now()) @db.Timestamp(0)
  producto    productos?        @relation(fields: [producto_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model productos {
  id             Int              @id @default(autoincrement())
  nombre         String?          @db.VarChar(100)
  categoria_id   Int?             @db.TinyInt
  cantidad       Int?             @default(0)
  unit           String           @default("pz") @db.VarChar(20)
  categoria      categorias?      @relation(fields: [categoria_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  donaciones     donaciones[]
  entregas       entregas[]
  movimientos    movimientos[]
  transferencias transferencias[]
}

model transferencias {
  id               Int                       @id @default(autoincrement())
  transferencia_id String?                   @unique(map: "uq_transferencias_transferencia_id") @db.VarChar(80)
  producto_id      Int?
  producto_nombre  String?                   @db.VarChar(100)
  categoria_id     Int?
  cantidad         Int                       @default(0)
  origen           String?                   @db.VarChar(100)
  destino          String?                   @db.VarChar(100)
  estado           String                    @default("PENDIENTE") @db.VarChar(30)
  evento_id        String?                   @db.VarChar(80)
  error            String?                   @db.Text
  created_at       DateTime?                 @default(now()) @db.Timestamp(0)
  updated_at       DateTime?                 @default(now()) @updatedAt @db.Timestamp(0)
  aprobacion       transferencias_aprobacion @default(en_espera)
  producto         productos?                @relation(fields: [producto_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model sync_events {
  id           Int       @id @default(autoincrement())
  evento_id    String    @unique(map: "uq_sync_events_evento_id") @db.VarChar(80)
  topic        String?   @db.VarChar(100)
  tipo         String    @db.VarChar(60)
  origen       String    @db.VarChar(100)
  destino      String?   @db.VarChar(100)
  payload      String    @db.LongText
  estado       String    @default("pendiente") @db.VarChar(30)
  intentos     Int       @default(0)
  ultimo_error String?   @db.Text
  created_at   DateTime? @default(now()) @db.Timestamp(0)
  updated_at   DateTime? @default(now()) @db.Timestamp(0)
}

model sync_events_recibidos {
  id          Int       @id @default(autoincrement())
  evento_id   String    @unique(map: "uq_sync_events_recibidos_evento_id") @db.VarChar(80)
  tipo        String    @db.VarChar(60)
  origen      String    @db.VarChar(100)
  payload     String    @db.LongText
  estado      String    @default("recibido") @db.VarChar(30)
  error       String?   @db.Text
  received_at DateTime? @default(now()) @db.Timestamp(0)
  applied_at  DateTime? @db.Timestamp(0)
}

enum movimientos_tipo {
  entrada
  salida
  transferencia
}

enum transferencias_aprobacion {
  en_espera
  aceptado
  denegado
}
